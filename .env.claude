# Environment baked into a local Claude client's launch config by
# `mise run install-claude-{code,desktop}` (fastmcp install --env-file).
#
# python-dotenv interpolates ${VAR} at install time, so no secret is committed
# and the path is per-user. A Dock-launched client sees no shell env and gets
# only this baked config, hence the explicit key passthroughs; unset ones bake
# to empty and are ignored (lore uses only the key matching its lore.toml
# models). ~/.claude already exists (Claude Code's home), so an absolute
# DATABASE_URL there needs no directory setup.
DATABASE_URL=sqlite:///${HOME}/.claude/lore.db
GEMINI_API_KEY=${GEMINI_API_KEY}
OPENAI_API_KEY=${OPENAI_API_KEY}
AWS_BEARER_TOKEN_BEDROCK=${AWS_BEARER_TOKEN_BEDROCK}
